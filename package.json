{
  "name": "nineclaw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lark-helper && npm run prepare:pi-runtime && tsc -b && vite build",
    "build:lark-helper": "esbuild scripts/lark-bot-helper.ts --bundle --platform=node --format=cjs --target=node18 --outfile=src-tauri/resources/bot-helpers/lark-helper.cjs",
    "prepare:pi-runtime": "node scripts/prepare-pi-runtime.mjs",
    "prepare:deps-and-pi": "npm install && npm run prepare:pi-runtime",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:macos": "bash scripts/build-macos.sh",
    "build:macos:dmg": "bash scripts/build-macos.sh --bundles dmg"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@mariozechner/pi-agent-core": "0.66.1",
    "@mariozechner/pi-ai": "0.66.1",
    "@mariozechner/pi-coding-agent": "0.66.1",
    "@mariozechner/pi-mom": "0.66.1",
    "@mariozechner/pi-tui": "0.66.1",
    "@mariozechner/pi-web-ui": "0.66.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.4"
  }
}

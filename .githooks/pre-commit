#!/bin/sh
# Pre-commit hook: protect the macOS pi launcher from Codex/linter rewrites.
#
# The pi launcher must skip SCRIPT_DIR when searching PATH for node on macOS,
# because the bundled thin node (68KB @loader_path wrapper) is killed by SIP/AMFI.
# Code formatters and AI assistants routinely revert this file to the broken
# "command -v node" version. This hook ALWAYS restores the correct content
# on every commit — it does NOT rely on detecting file changes.
#
# Setup (one-time):
#   git config core.hooksPath .githooks

PI_FILE="src-tauri/resources/pi-runtime/macos/pi"

# Always write the correct content — do not skip based on diff detection
# (Codex may have modified the file but not yet committed it)
echo "[pre-commit hook] Ensuring correct pi launcher (macOS SIP/AMFI workaround)..."

cat > "$PI_FILE" << 'PIEOF'
#!/bin/sh
# Bundled pi launcher generated during build.
set -eu
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
NODE_BIN="$SCRIPT_DIR/node"
if [ "$(uname -s)" = "Darwin" ]; then
  # On macOS the bundled thin node launcher may be blocked by SIP / AMFI
  # when its @loader_path dylibs are unsigned.  Prefer a system-installed
  # node if one exists (search PATH *without* SCRIPT_DIR so the bundled
  # node is not found ahead of the real one).
  _saved_IFS="$IFS"
  IFS=':'
  _found=
  for _dir in $PATH; do
    case "$_dir" in
      "$SCRIPT_DIR") continue ;;
    esac
    if [ -x "$_dir/node" ]; then
      _found="$_dir/node"
      break
    fi
  done
  IFS="$_saved_IFS"
  if [ -n "$_found" ]; then
    NODE_BIN="$_found"
  fi
fi
if [ -d "$SCRIPT_DIR/lib" ]; then
  export DYLD_LIBRARY_PATH="$SCRIPT_DIR/lib${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
  export LD_LIBRARY_PATH="$SCRIPT_DIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
exec "$NODE_BIN" "$SCRIPT_DIR/pi-package/dist/cli.js" "$@"
PIEOF

chmod +x "$PI_FILE"
git add "$PI_FILE"

echo "[pre-commit hook] Done."
